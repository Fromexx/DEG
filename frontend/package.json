{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "npm run test:unit && npm run test:components",
		"test:unit": "node --experimental-strip-types --test tests/*.test.ts",
		"test:components": "vitest run",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.12",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"eslint": "^10.14.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"globals": "^17.13.0",
		"jsdom": "^31.0.1",
		"sass-embedded": "^1.108.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=22.18.0"
	}
}
